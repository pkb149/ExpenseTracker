{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/_worker.js --format=esm --target=es2022 --external:node:*",
    "check": "node scripts/check-js.js",
    "dev": "npm run build && npm run check && wrangler pages dev dist",
    "deploy": "npm run build && npm run check && wrangler pages deploy dist",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250526.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.98.0"
  }
}
